# ----------------------------------------------------------------------
# 1. Specify PHP Version
# ----------------------------------------------------------------------
AddHandler application/x-httpd-php84 .php

# ----------------------------------------------------------------------
# 2. Security and Performance Headers
# ----------------------------------------------------------------------
ServerSignature Off
Options -Indexes

# ----------------------------------------------------------------------
# 3. Rewrite Engine (Core CI4 Logic)
# ----------------------------------------------------------------------
<IfModule mod_rewrite.c>
    # Pastikan SymLinks aktif agar rewrite bekerja
    Options +FollowSymLinks
    RewriteEngine On

    # A. Redirect Trailing Slashes (Menghapus / di akhir URL agar konsisten)
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # B. Handle Authorization Header (Penting untuk API/JWT)
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # C. Sembunyikan index.php & Redirect ke Controller
    # Jika file atau direktori fisik tidak ditemukan, arahkan ke index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# Fallback jika mod_rewrite tidak aktif
<IfModule !mod_rewrite.c>
    ErrorDocument 404 /index.php
</IfModule>

# ----------------------------------------------------------------------
# 4. Additional Security Headers
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    # Tambahan: Mencegah kebocoran referer (Opsional tapi bagus)
    Header always set Referrer-Policy "no-referrer-when-downgrade"
    Header always set Content-Security-Policy "default-src 'self'; font-src 'self' https://fonts.gstatic.com https://fonts.googleapis.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://rsms.me data:; style-src 'self' https://fonts.googleapis.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://cdn.datatables.net https://rsms.me 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://cdn.datatables.net; img-src 'self' data: https: blob:; frame-src 'self' blob:; connect-src 'self' https://cdn.datatables.net;"
</IfModule>

# ----------------------------------------------------------------------
# 5. Browser Caching (Fonts, CSS, JS, Images)
# ----------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType font/woff2 .woff2
    AddType font/woff .woff
    AddType font/ttf .ttf
    AddType font/eot .eot
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    
    # Webfonts - 1 Year (Static & Immutable)
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    ExpiresByType application/x-font-ttf "access plus 1 year"
    ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
    
    # CSS & JavaScript - 1 Month
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    
    # Images & Favicon - 1 Month / 1 Year
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
    # Cache font files aggressively (woff2, woff, ttf, eot)
    <FilesMatch \.(woff2?|ttf|eot|otf)$>
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    # Cache CSS and JS
    <FilesMatch \.(css|js)$>
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    
    # Cache Images
    <FilesMatch \.(ico|png|jpg|jpeg|svg|webp)$>
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>
